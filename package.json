{
  "name": "werss3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "playwright test",
    "test:e2e": "playwright test tests/e2e",
    "test:contract": "playwright test --project=contract-auth --project=contract-articles --project=contract-feeds --project=contract-groups --project=contract-favorites --project=contract-sync",
    "test:auth": "playwright test tests/contract/auth",
    "test:articles": "playwright test tests/contract/articles",
    "test:feeds": "playwright test tests/contract/feeds",
    "test:groups": "playwright test tests/contract/groups",
    "test:favorites": "playwright test tests/contract/favorites",
    "test:sync": "playwright test tests/contract/sync",
    "test:ui": "playwright test tests/e2e/ui",
    "test:report": "playwright show-report",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:deploy": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run tests/integration",
    "db:presets": "tsx scripts/seed-presets.ts",
    "verify:e2e": "node scripts/e2e-verify.mjs",
    "verify:ui": "node scripts/ui-verify.mjs",
    "verify": "node scripts/e2e-verify.mjs && node scripts/ui-verify.mjs"
  },
  "dependencies": {
