# ============================================================================
# WeRSS 环境变量示例
# ----------------------------------------------------------------------------
# 用法：复制此文件为 .env，然后按下面说明填写。
#
#   cp .env.example .env
#
# .env 已在 .gitignore 中，不会被提交。（.env.local 同样被忽略）
# ============================================================================

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 本项目使用 SQLite（见 prisma/schema.prisma: provider = "sqlite"）。
# 数据库文件相对于 prisma/ 目录，因此 "file:./dev.db" 实际指向 prisma/dev.db。
#
# 首次初始化数据库：
#   npx prisma migrate deploy    # 应用已有迁移（推荐，幂等）
#   npx prisma db seed           # 灌入演示数据（可选）
DATABASE_URL="file:./dev.db"

# 如果要换成 PostgreSQL / MySQL：
#   1. 修改 prisma/schema.prisma 里的 provider
#   2. 修改这里的 DATABASE_URL
#   3. 删除 prisma/migrations 后重新执行 npx prisma migrate dev
#
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/werss?schema=public"

# ---------------------------------------------------------------------------
# 安全密钥（必填）
# ---------------------------------------------------------------------------
# JWT_SECRET 用于签发/校验登录令牌。
#
# 生成方式（任选其一）：
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 要求：
#   - 至少 32 个字符
#   - 不能使用任何示例值（程序会显式拒绝，直接报错退出）
#   - 生产环境必须与开发环境不同；泄露后等同于所有账号可被伪造登录
JWT_SECRET=""

# NextAuth 兼容用的 secret（当前版本由自有 JWT 逻辑接管，保留此项以兼容旧配置）
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# 运行环境
# ---------------------------------------------------------------------------
# development | production | test
NODE_ENV="development"

# ---------------------------------------------------------------------------
# 可选：访客 / 演示模式
# ---------------------------------------------------------------------------
# 开启后，未登录用户会以共享的「访客」账号浏览内容。
# 注意：所有访客共享同一账号，请勿在生产环境开启，除非明确知道后果。
#
# 开发环境默认开启；生产环境默认关闭。
ALLOW_GUEST_MODE="false"

# ---------------------------------------------------------------------------
# 可选：允许订阅内网地址的 RSS 源
# ---------------------------------------------------------------------------
# 默认关闭。服务端会拒绝请求环回地址、私有网段、云元数据地址等，
# 防止有人借这个实例去探测你内网里的服务（SSRF）。
#
# 如果你确实要订阅自己内网里的源（比如在 NAS 上自建的 RSSHub：
# http://192.168.1.10:1200/rsshub），把它设为 true。
# 开启后请确保这个实例只有你自己能访问。
ALLOW_PRIVATE_FEED_URLS="false"

# ---------- 反向代理（可选） ----------
# 速率限制要判断「是谁在请求」，但 Next.js 的 Route Handler 拿不到 TCP
# 连接的真实对端地址，只能读 X-Forwarded-For —— 而这个头客户端可以自己
# 填，Next 会原样透传。
#
# 如果你把这个实例放在 nginx / Caddy / Traefik 后面，并且反代设置为
# 「覆盖」而不是「追加」这个头，就把它设为 true，此时程序取最后一跳
# （你的反代填的真实地址），客户端伪造的首段失效。
#
# 没有反代时保持 false：此时只能取第一跳，虽然可伪造，但关键接口都另有
# 一层不依赖 IP 的全局上限兜底（伪造 IP 也顶不破）。
TRUST_PROXY="false"

# ---------- 定时任务凭据（可选） ----------
# POST /api/cron/digest 用这个密钥鉴权。它要遍历所有用户发邮件，
# 不能基于某个用户的登录态，所以必须有自己的凭据。
# 不配置时该接口返回 503（而不是默认放行）。
# 生成方式同 JWT_SECRET：openssl rand -base64 32
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Kindle 推送（可选）
# ---------------------------------------------------------------------------
# 不配也能正常使用，只是阅读器里不会出现「推送到 Kindle」按钮。
#
# 原理：Kindle 的 Send-to-Kindle 是纯邮件流程 —— 把文件作为附件
# 发到你的 xxx@kindle.com 或 xxx@kindle.cn，Amazon 再推到设备。
# 所以只需要一个能发信的 SMTP 账号，不需要 Amazon API 或任何 Key。
#
# 注意：推送后要能在 Kindle 上收到，还必须到 Amazon
# 「管理我的内容和设备 → 首选项 → 个人文档设置」里，把 SMTP_FROM
# 的地址加入「已批准的个人文档电子邮件列表」，否则会被静默丢弃。
#
# SMTP_HOST="smtp.example.com"        # QQ 邮箱 smtp.qq.com，Gmail smtp.gmail.com
# SMTP_PORT="587"                     # 587 用 STARTTLS；465 用隐式 TLS
# SMTP_SECURE="false"                 # 端口 465 时设为 true
# SMTP_USER="your-email@example.com"
# SMTP_PASSWORD="your-app-password"   # 注意：多数邮箱要「授权码/应用专用密码」，不是登录密码
# SMTP_FROM="your-email@example.com"  # 省略时用 SMTP_USER
