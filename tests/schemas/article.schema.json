{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Article Schema",
  "description": "RSS 文章在列表接口里的形状（app/api/articles/route.ts 的 select 结果）",
  "type": "object",
  "required": ["id", "title", "link", "pubDate", "isRead", "isFavorited"],
  "properties": {
    "id": { "type": "string", "description": "文章唯一标识" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "文章标题"
    },
    "description": { "type": "string", "description": "列表用摘要（纯文本，已净化）" },
    "link": { "type": "string", "format": "uri", "description": "原文地址" },
    "pubDate": { "type": "string", "format": "date-time", "description": "发布时间" },
    "isRead": { "type": "boolean", "description": "当前用户是否已读" },
    "isFavorited": {
      "type": "boolean",
      "description": "当前用户是否收藏。字段名是 isFavorited，不是 isStarred —— 早期契约表写的是 isStarred，与实际不符"
    },
    "favoriteCount": { "type": "integer", "minimum": 0, "description": "全局收藏数" },
    "imageUrl": {
      "type": ["string", "null"],
      "description": "缩略图地址；全量抓取后从正文首图兜底提取"
    },
    "author": { "type": ["string", "null"], "description": "作者" },
    "feed": {
      "type": "object",
      "description": "所属源的精简信息",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "icon": { "type": ["string", "null"] }
      },
      "required": ["id", "title"]
    }
  },
  "additionalProperties": false
}
