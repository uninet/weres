{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feed Schema",
  "description": "RSS 源对象（prisma Feed 模型 + 未读计数）",
  "type": "object",
  "required": ["id", "title", "url"],
  "properties": {
    "id": { "type": "string", "description": "源唯一标识" },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "源标题"
    },
    "url": { "type": "string", "format": "uri", "description": "RSS 地址" },
    "description": { "type": ["string", "null"], "description": "源简介" },
    "icon": { "type": ["string", "null"], "description": "favicon 地址" },
    "category": { "type": ["string", "null"], "description": "分类" },
    "language": { "type": ["string", "null"], "description": "语言" },
    "isActive": { "type": "boolean", "description": "是否参与同步" },
    "syncStatus": {
      "type": "string",
      "description": "同步状态：IDLE / SYNCING / SUCCESS / FAILED"
    },
    "lastSyncAt": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "上次同步时间"
    },
    "lastError": { "type": ["string", "null"], "description": "上次同步错误" },
    "errorCount": { "type": "integer", "minimum": 0, "description": "连续失败次数" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
