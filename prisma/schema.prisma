generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String?   @map("password_hash")
  nickname      String?
  avatar        String?
  bio           String?
  status        String    @default("ACTIVE")
  emailVerified DateTime? @map("email_verified")
  phoneVerified DateTime? @map("phone_verified")
  /// Kindle 推送投递地址。Amazon 会给每个 Kindle 分配
  /// `xxx@kindle.com`（国际）/ `xxx@kindle.cn`（中国），
  /// 用户填进来后由服务端代发文章。
  kindleEmail   String?   @map("kindle_email")
  /// 是否为新文章生成站内通知。
  ///
  /// 这是「总开关」，Subscription.isNotify 是「单源开关」——
  /// 两者都开着才会为该源的新文章写通知。存在数据库而不是
  /// localStorage，因为生成通知的是服务端同步任务，它读不到浏览器。
  notifyNewArticles Boolean @default(true) @map("notify_new_articles")
  /// 是否接收每日摘要邮件。
  ///
  /// 打开后只是「授权发送」，真正发送由外部定时任务调用
  /// POST /api/cron/digest 触发（见 README）。放在服务端是因为
  /// 发送方是定时任务，同样读不到 localStorage。
  emailDigest   Boolean   @default(false) @map("email_digest")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  subscriptions Subscription[]
  groups        Group[]
  favorites     Favorite[]
  readHistories ReadHistory[]
  notifications Notification[]
  loginLogs     LoginLog[]
  tags          Tag[]
  kindleDeliveries KindleDelivery[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model Feed {
  id          String     @id @default(cuid())
  url         String     @unique
  title       String
  description String?
  icon        String?
  category    String     @default("OTHER")
  language    String?
  lastSyncAt  DateTime?  @map("last_sync_at")
  syncStatus  String     @default("PENDING") @map("sync_status")
  errorCount  Int        @default(0) @map("error_count")
  lastError   String?    @map("last_error")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  subscriptions Subscription[]
  articles      Article[]
  marketFeed    MarketFeed?

  @@index([category])
  @@index([syncStatus])
  @@index([isActive])
  @@map("feeds")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  feedId    String   @map("feed_id")
  groupId   String?  @map("group_id")
  isNotify  Boolean  @default(true) @map("is_notify")
  createdAt DateTime @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feed  Feed   @relation(fields: [feedId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([userId, feedId])
  @@index([userId])
  @@index([feedId])
  @@map("subscriptions")
}

model Group {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([userId])
  @@map("groups")
}

model MarketFeed {
  id              String   @id @default(cuid())
  feedId          String   @unique @map("feed_id")
  category        String
  isFeatured      Boolean  @default(false) @map("is_featured")
  subscriberCount Int      @default(0) @map("subscriber_count")
  avgUpdateFreq   Int?     @map("avg_update_freq")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([isFeatured])
  @@index([status])
  @@map("market_feeds")
}

model Article {
  id          String    @id @default(cuid())
  feedId      String    @map("feed_id")
  title       String
  link        String
  description String?
  content     String?
  author      String?
  pubDate     DateTime  @map("pub_date")
  imageUrl    String?   @map("image_url")
  guid        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  feed          Feed           @relation(fields: [feedId], references: [id], onDelete: Cascade)
  favorites     Favorite[]
  readHistories ReadHistory[]
  articleTags   ArticleTag[]
  kindleDeliveries KindleDelivery[]

  /// guid 不能全局唯一。
  ///
  /// 同一个 guid 只在一个源内唯一：两个源（比如某站的「全文 RSS」和
  /// 「摘要 RSS」）会给出相同的 guid/link，甚至很多源根本没有 guid，
  /// 代码会退化成 guid = link。此时全局唯一会让第二个源的文章插入时
  /// 撞唯一约束、被 catch 吞掉当成同步错误 —— 表现为「订阅了但一篇都
  /// 没有」，而且日志里只有一句重复键错误。
  ///
  /// 跨源重复展示的问题在查询层解决（按 link 去重），不在写入层拦。
  @@unique([feedId, guid])
  @@index([feedId])
  @@index([pubDate])
  @@index([createdAt])
  @@index([link])
  @@map("articles")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@map("favorites")
}

model ReadHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  readAt    DateTime @default(now()) @map("read_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
  @@index([articleId])
  @@index([readAt])
  @@map("read_histories")
}

model Tag {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  color     String   @default("#3B82F6")
  createdAt DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  articleTags ArticleTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model ArticleTag {
  id        String @id @default(cuid())
  articleId String @map("article_id")
  tagId     String @map("tag_id")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([articleId, tagId])
  @@index([articleId])
  @@index([tagId])
  @@map("article_tags")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  content   String?
  data      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// 登录审计日志。
///
/// 登录接口每次成功认证都会写一条（见 app/api/auth/login/route.ts）。
/// 写失败不影响登录本身 —— 拿不到 IP/UA 不该把用户挡在门外。
model LoginLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  /// 客户端 IP（来自 getClientIdentifier，已考虑 X-Forwarded-For）
  ipAddress   String   @map("ip_address")
  /// 浏览器 User-Agent，截断到 500 字符防超长脏数据
  userAgent   String   @map("user_agent")
  /// 预留的设备描述字段；当前留空（解析 UA 需要额外依赖，
  /// 而 ip + userAgent + loginAt 已足够回答「何时从哪台机器登录」）
  deviceInfo  String?  @map("device_info")
  loginAt     DateTime @default(now()) @map("login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loginAt])
  @@map("login_logs")
}

/// Kindle 推送记录。
///
/// 为什么单独建表而不是只写日志：用户需要看到「哪篇文章推到过 Kindle、
/// 什么时候推的、成功还是失败」。SMTP 失败原因（邮箱没在白名单、
/// 附件超限）在控制台里一闪而过，用户根本不知道要改什么。
model KindleDelivery {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  articleId String   @map("article_id")
  toEmail   String   @map("to_email")
  status    String   @default("PENDING")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("kindle_deliveries")
}

/// 密码重置令牌。
///
/// 只存 token 的 SHA-256 哈希，不存原文 —— 数据库泄露时，
/// 攻击者拿到哈希也没法反推出能用的链接。原文只出现在邮件里。
/// usedAt 而不是删行：保留使用记录才能查出「这个 token 什么时候被用掉的」。
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}
